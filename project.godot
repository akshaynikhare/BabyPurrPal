; Engine configuration file.

config_version=5

[application]

config/name="BabyPurrPal"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://icon.svg"
run/max_fps=60
boot_splash/bg_color=Color(1, 0.956863, 0.878431, 1)
boot_splash/image="res://assets/textures/boot_splash.png"
config/quit_on_go_back=false

[autoload]

EventBus="*res://autoload/event_bus.gd"
Settings="*res://autoload/settings.gd"
AudioDirector="*res://autoload/audio_director.gd"
Haptics="*res://autoload/haptics.gd"
Lifecycle="*res://autoload/lifecycle.gd"

[audio]

driver/enable_input=true

[display]

window/size/viewport_width=720
window/size/viewport_height=1600
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=2
